{
  "hosting": {
    "target": "cortex",
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "crop_logo.py",
      "start_app.py",
      "test_info.png",
      "split_files.py",
      "index.backup.html",
      "play_store_package/**",
      "store_assets/**",
      "play_store_guide.md"
    ],
    "rewrites": [
      {
        "source": "/api/tiktok/session",
        "function": "tiktokAdminSession",
        "region": "us-central1"
      },
      {
        "source": "/api/telemetry",
        "function": "telemetry",
        "region": "us-central1"
      },
      {
        "source": "/api/gemini",
        "function": "callGeminiHttp",
        "region": "us-central1"
      },
      {
        "source": "/api/tts",
        "function": "textToSpeechHttp",
        "region": "us-central1"
      },
      {
        "source": "/api/tiktok/auth",
        "function": "tiktokAuthUrl",
        "region": "us-central1"
      },
      {
        "source": "/api/tiktok/exchange",
        "function": "tiktokExchangeToken",
        "region": "us-central1"
      },
      {
        "source": "/api/tiktok/status",
        "function": "tiktokStatus",
        "region": "us-central1"
      },
      {
        "source": "/api/tiktok/publish",
        "function": "tiktokPublish",
        "region": "us-central1"
      },
      {
        "source": "/api/tiktok/publish-status",
        "function": "tiktokPublishStatus",
        "region": "us-central1"
      },
      {
        "source": "/app",
        "destination": "/app.html"
      },
      {
        "source": "/app/**",
        "destination": "/app.html"
      },
      {
        "source": "/sw.js",
        "destination": "/sw.js"
      },
      {
        "source": "/oauth/callback",
        "destination": "/oauth-callback.html"
      },
      {
        "source": "/settings",
        "destination": "/app.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/simulazione-tolc",
        "destination": "/simulazione-tolc.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/consulente-del-lavoro-e-scienze-dei-servizi-giuridici-triennale-messina",
        "destination": "/consulente-del-lavoro-e-scienze-dei-servizi-giuridici-messina",
        "type": 301
      },
      {
        "source": "/giurisprudenza-magistrale-a-ciclo-unico-messina",
        "destination": "/giurisprudenza-messina",
        "type": 301
      },
      {
        "source": "/scienze-gastronomiche-triennale-messina",
        "destination": "/scienze-gastronomiche-messina",
        "type": 301
      },
      {
        "source": "/scienze-della-formazione-e-della-comunicazione-triennale-messina",
        "destination": "/scienze-della-formazione-e-della-comunicazione-messina",
        "type": 301
      },
      {
        "source": "/scienze-e-tecniche-psicologiche-triennale-messina",
        "destination": "/scienze-e-tecniche-psicologiche-messina",
        "type": 301
      },
      {
        "source": "/scienze-dell-amministrazione-e-dell-organizzazione-triennale-messina",
        "destination": "/scienze-dell-amministrazione-e-dell-organizzazione-messina",
        "type": 301
      },
      {
        "source": "/infermieristica-triennale-messina",
        "destination": "/infermieristica-messina",
        "type": 301
      },
      {
        "source": "/chimica-triennale-messina",
        "destination": "/chimica-messina",
        "type": 301
      },
      {
        "source": "/ingegneria-civile-triennale-messina",
        "destination": "/ingegneria-civile-messina",
        "type": 301
      },
      {
        "source": "/ingegneria-gestionale-triennale-messina",
        "destination": "/ingegneria-gestionale-messina",
        "type": 301
      },
      {
        "source": "/matematica-triennale-messina",
        "destination": "/matematica-messina",
        "type": 301
      },
      {
        "source": "/scienze-politiche-e-delle-relazioni-internazionali-messina",
        "destination": "/unime",
        "type": 301
      },
      {
        "source": "/t",
        "destination": "/?utm_source=tiktok&utm_medium=video",
        "type": 302
      },
      {
        "source": "/ig",
        "destination": "/?utm_source=instagram&utm_medium=bio",
        "type": 302
      },
      {
        "source": "/yt",
        "destination": "/?utm_source=youtube&utm_medium=video",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(self), geolocation=()"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://accounts.google.com; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://accounts.google.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.googleusercontent.com https://*.gstatic.com https://firebasestorage.googleapis.com https://flagcdn.com https://img.youtube.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://firebasestorage.googleapis.com https://*.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://accounts.google.com https://www.google-analytics.com https://analytics.google.com https://*.clarity.ms https://api.stripe.com https://open.tiktokapis.com; frame-src 'self' https://accounts.google.com https://*.google.com https://checkout.stripe.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; media-src 'self' blob: data: https:"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8189
    },
    "functions": {
      "port": 5001
    }
  }
}
