rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica se l'utente è un amministratore.
    // Controlla il Custom Claim (admin: true) OPPURE il UID hardcoded dell'admin.
    // Il UID è il metodo principale — i Custom Claims richiedono l'Admin SDK.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.uid == 'f8oLEt3LDpT7VN9zFOa10mVE2Cf2'
      );
    }

    // Helper: Validazione lunghezza stringhe per prevenire spam
    function isValidString(str, maxLength) {
      return str is string && str.size() <= maxLength;
    }

    // Audit 2026-10 (F01, fasi 1.2 e 3): durante/dopo l'eliminazione account il
    // server crea _deletionLocks/{uid}; da quel momento nessun client (anche con
    // un token ancora valido in un'altra scheda) può ricreare dati per quell'uid,
    // né creare relazioni/feedback/segnalazioni che lo riguardano.
    function notDeleting(uid) {
      return !exists(/databases/$(database)/documents/_deletionLocks/$(uid));
    }

    // NOTA sicurezza (22/07/2026): le regole Firestore NON supportano query/count(),
    // quindi il rate-limit "max N mazzi pubblici al giorno" va fatto in una Cloud Function
    // (o con un doc contatore per-utente aggiornato via transazione). Qui restano solo i
    // limiti per-documento (ownerId, lunghezze, max 200 card).

    // 📦 Mazzi Pubblici: Chiunque può leggerli (per importare).
    // Creazione: Utenti autenticati, con limiti anti-spam:
    //   - max 200 card per mazzo
    //   - ownerId deve corrispondere all'utente autenticato
    //   - titolo e descrizione rispettano lunghezze massime
    // Update/Delete: Solo il proprietario (ownerId) o un admin.
    match /publicDecks/{deckId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && notDeleting(request.auth.uid)
        && isValidString(request.resource.data.name, 200)
        && (!('description' in request.resource.data) || isValidString(request.resource.data.description, 1000))
        && (!('cardsCount' in request.resource.data) || (request.resource.data.cardsCount is int && request.resource.data.cardsCount >= 0 && request.resource.data.cardsCount <= 200))
        && (!('cards' in request.resource.data) || request.resource.data.cards.size() <= 200);
      allow update: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId
        && isValidString(request.resource.data.name, 200)
        && (!('cardsCount' in request.resource.data) || (request.resource.data.cardsCount is int && request.resource.data.cardsCount >= 0 && request.resource.data.cardsCount <= 200))
        && (!('cards' in request.resource.data) || request.resource.data.cards.size() <= 200);
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // 🚩 Report mazzi: utenti loggati possono segnalare un mazzo una volta sola
    match /deckReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && notDeleting(request.auth.uid)
        && isValidString(request.resource.data.reason, 500);
      allow read, update, delete: if isAdmin();
    }

    // 🧠 Profili Utente: per la classifica pubblica (lettura pubblica).
    // Audit 2026-10 (fase 1.4): gli XP sono calcolati sul dispositivo, quindi la
    // classifica è INDICATIVA. Per limitare i falsi evidenti: alla creazione XP ≤ 1000,
    // poi al massimo +1000 per aggiornamento e un aggiornamento XP ogni 60 secondi
    // (lastSync = ora del server). Non rende la classifica verificata.
    match /userProfiles/{username} {
      function xpOk(v, maxV) { return v is int && v >= 0 && v <= maxV; }
      function prevXp() { return resource.data.get('xp', 0); }
      function xpUpdateOk() {
        return xpOk(request.resource.data.xp, prevXp() + 1000)
          && request.resource.data.lastSync == request.time
          && (!('lastSync' in resource.data) || !(resource.data.lastSync is timestamp)
              || request.time > resource.data.lastSync + duration.value(60, 's'));
      }
      allow read: if true;
      allow create: if request.auth != null && (isAdmin() || (
        request.resource.data.uid == request.auth.uid
        && notDeleting(request.auth.uid)
        && (!('xp' in request.resource.data) || xpOk(request.resource.data.xp, 1000))
        && (!('totalXP' in request.resource.data) || xpOk(request.resource.data.totalXP, 1000))
        && (!('weeklyXP' in request.resource.data) || xpOk(request.resource.data.weeklyXP, 1000))
        && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 50))
      ));
      allow update: if request.auth != null && (isAdmin() || (
        resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && notDeleting(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','xp','level','lastSync','neuralStats','lastUpdate','architectLevel'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp']) || xpUpdateOk())
        && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 50))
      ));
      allow delete: if request.auth != null && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    // 👤 Dati Privati Utente (Cloud Sync): Solo il proprietario può accedere.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // 🔒 SICUREZZA (11/08/2026 — fix falla "premium gratis"): i campi di
      // abbonamento e crediti sono FONTE DI VERITÀ e vengono scritti SOLO dal
      // backend (Cloud Functions via Admin SDK, che bypassa queste regole).
      // Il client NON può auto-assegnarseli: senza questo blocco un utente poteva
      // scriversi plan:'pro' e sparksBalance enorme dalla console → premium + AI
      // illimitata gratis. Campi protetti dal client:
      function _billingProtetti() {
        return [
          'plan','planCycle','planSource','planUpdatedAt','planExpiresAt',
          'sparksBalance','trialPlan','trialExpiresAt','stripeCustomerId',
          'stripeSubscriptionId','googlePlaySubscription','googlePlayPurchases',
          // Fase 4 (audit 2026-10): stato Stripe riconciliato, letto dai gate premium.
          'stripeSubscription',
          // Referral (audit 2026-10, fase 1.3): premi e stato li scrive solo
          // claimReferral. referredBy/refCode restano scrivibili ma il server li
          // ignora (compatibilità con client già aperti); da bloccare più avanti.
          'referralProcessed','referralCount','referralDaysEarned','referralRewardAt'
        ];
      }
      allow create: if request.auth != null && request.auth.uid == userId
        && notDeleting(userId)
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && (!('sparksBalance' in request.resource.data) || request.resource.data.sparksBalance == 0)
        && !request.resource.data.keys().hasAny([
             'planCycle','planSource','planUpdatedAt','planExpiresAt',
             'trialPlan','trialExpiresAt','stripeCustomerId','stripeSubscriptionId','stripeSubscription',
             'googlePlaySubscription','googlePlayPurchases',
             'referralProcessed','referralCount','referralDaysEarned','referralRewardAt']);
      allow update: if request.auth != null && request.auth.uid == userId
        && notDeleting(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(_billingProtetti());
      // Account deletion must preserve server receipt tombstones before removing user data.
      allow delete: if false; // deleteUserAccount (Admin SDK)

      // 📚 Sub-collection per i mazzi
      match /decks/{deckId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && notDeleting(userId);
      }

      // 🧠 Sub-collection per la memoria (Coach AI)
      match /memory/{memoryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && notDeleting(userId);
      }
    }

    // 💬 Feedback Community (Plurale):
    // Read: Pubblico (per vedere cosa dicono gli altri).
    // Create: Solo utenti loggati (per evitare spam massivo anonimo).
    // Update/Delete: Solo l'amministratore.
    match /feedbacks/{docId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['userId','alias','text','timestamp']) &&
        request.resource.data.userId == request.auth.uid &&
        notDeleting(request.auth.uid) &&
        request.resource.data.timestamp == request.time &&
        isValidString(request.resource.data.text, 2048) &&
        isValidString(request.resource.data.alias, 100);
      allow update, delete: if isAdmin();
    }
    
    // NOTA: La collezione legacy 'feedback' (singolare) è stata rimossa per sicurezza.

    // ⚔️ Neural Duels: il matchmaking e ogni cambio di stato passano dal backend.
    // I partecipanti possono solo leggere la propria partita in tempo reale.
    match /duels/{duelId} {
      allow read: if request.auth != null && (
        resource.data.player1.id == request.auth.uid || resource.data.player2.id == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // 👤 Social Profiles: i profili non pubblici sono leggibili solo dal proprietario.
    // I contatori social vengono mantenuti dai trigger server, mai dai client.
    match /profiles/{profileId} {
      function validProfile() {
        return request.resource.data.keys().hasOnly([
          'uid','displayName','photoURL','bio','university','corso','annoCorso',
          'materiaPreferita','studyStyle','isPublic','totalCards','streak',
          'badgeCount','publicDecks','followersCount','followingCount','friendsCount',
          'createdAt','updatedAt'
        ])
        && request.resource.data.uid == profileId
        && request.resource.data.isPublic is bool
        && (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 50))
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == '' || (isValidString(request.resource.data.photoURL, 2048) && request.resource.data.photoURL.matches('https://.*')))
        && (!('bio' in request.resource.data) || isValidString(request.resource.data.bio, 150))
        && (!('university' in request.resource.data) || isValidString(request.resource.data.university, 80))
        && (!('corso' in request.resource.data) || isValidString(request.resource.data.corso, 80))
        && (!('annoCorso' in request.resource.data) || isValidString(request.resource.data.annoCorso, 20))
        && (!('materiaPreferita' in request.resource.data) || isValidString(request.resource.data.materiaPreferita, 60))
        && (!('studyStyle' in request.resource.data) || isValidString(request.resource.data.studyStyle, 200))
        && (!('totalCards' in request.resource.data) || (request.resource.data.totalCards is int && request.resource.data.totalCards >= 0 && request.resource.data.totalCards <= 1000000))
        && (!('streak' in request.resource.data) || (request.resource.data.streak is int && request.resource.data.streak >= 0 && request.resource.data.streak <= 100000))
        && (!('badgeCount' in request.resource.data) || (request.resource.data.badgeCount is int && request.resource.data.badgeCount >= 0 && request.resource.data.badgeCount <= 100000))
        && (!('publicDecks' in request.resource.data) || (request.resource.data.publicDecks is int && request.resource.data.publicDecks >= 0 && request.resource.data.publicDecks <= 100000))
        && (!('followersCount' in request.resource.data) || (request.resource.data.followersCount is int && request.resource.data.followersCount >= 0 && request.resource.data.followersCount <= 100000000))
        && (!('followingCount' in request.resource.data) || (request.resource.data.followingCount is int && request.resource.data.followingCount >= 0 && request.resource.data.followingCount <= 100000000))
        && (!('friendsCount' in request.resource.data) || (request.resource.data.friendsCount is int && request.resource.data.friendsCount >= 0 && request.resource.data.friendsCount <= 100000000));
      }

      allow read: if (request.auth != null && request.auth.uid == profileId) || resource.data.isPublic == true;
      allow create: if request.auth != null
        && request.auth.uid == profileId
        && request.resource.data.uid == request.auth.uid
        && notDeleting(profileId)
        // Contatori social: li mantengono i trigger server; alla creazione 0 o assenti
        // (anche dopo delete + ricreazione del profilo). Audit 2026-10, fase 1.4.
        && (!('followersCount' in request.resource.data) || request.resource.data.followersCount == 0)
        && (!('followingCount' in request.resource.data) || request.resource.data.followingCount == 0)
        && (!('friendsCount' in request.resource.data) || request.resource.data.friendsCount == 0)
        && validProfile();
      allow update: if request.auth != null
        && request.auth.uid == profileId
        && notDeleting(profileId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoURL','bio','university','corso','annoCorso',
          'materiaPreferita','studyStyle','isPublic','totalCards','streak',
          'badgeCount','publicDecks','createdAt','updatedAt'
        ])
        && validProfile();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ➕ Follow: relazione "uid_targetUid" → chi segue chi.
    // Scrittura: solo chi crea/elimina il proprio follow (uid estratto dall'id doc).
    match /follows/{followId} {
      // resource == null: get di un follow inesistente (isFollowing) -> consentito solo sul proprio id
      allow read: if request.auth != null && (
        resource == null
          ? followId.matches(request.auth.uid + '_.+')
          : (resource.data.followerUid == request.auth.uid || resource.data.followingUid == request.auth.uid)
      );
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['followerUid','followingUid','createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && notDeleting(request.auth.uid)
        && notDeleting(request.resource.data.followingUid)
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingUid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.followingUid));
      allow delete: if request.auth != null
        && resource.data.followerUid == request.auth.uid
        && followId == resource.data.followerUid + '_' + resource.data.followingUid;
      allow update: if false; // i follow non si modificano, si cancellano e ricrean
    }

    // 🤝 Amicizie: relazione bidirezionale "uid_targetUid".
    // Creata solo da acceptFriendRequest (batch atomico): chi accetta è l'utente autenticato.
    match /friends/{friendshipId} {
      // resource == null: get di un'amicizia inesistente (isFriend) -> consentito solo sul proprio id
      allow read: if request.auth != null && (
        resource == null
          ? friendshipId.matches(request.auth.uid + '_.+')
          : (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid)
      );
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid1','uid2','requestId','createdAt'])
        && request.resource.data.uid1 is string
        && request.resource.data.uid2 is string
        && request.resource.data.uid1 != request.resource.data.uid2
        && friendshipId == request.resource.data.uid1 + '_' + request.resource.data.uid2
        && (request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid)
        && notDeleting(request.resource.data.uid1)
        && notDeleting(request.resource.data.uid2)
        && request.resource.data.requestId is string
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid in [request.resource.data.uid1, request.resource.data.uid2];
      allow delete: if request.auth != null && (
        resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid
      );
      allow update: if false;
    }

    // 📨 Richieste di amicizia: utente autenticato crea, il destinatario accetta/rifiuta.
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['fromUid','toUid','status','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && notDeleting(request.auth.uid)
        && notDeleting(request.resource.data.toUid)
        && isValidString(request.resource.data.fromUid, 128)
        && isValidString(request.resource.data.toUid, 128)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.toUid));
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if request.auth != null && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );
    }

    // 💳 Stripe Customers: accesso solo tramite Admin SDK (Cloud Functions).
    // Nessun client deve mai leggere o scrivere qui.
    match /stripeCustomers/{customerId} {
      allow read, write: if false;
    }

    // 📊 Usage (rate limiting IA): scritto/letto solo dalla Cloud Function callGeminiProxy.
    // Se un client potesse scrivere qui, potrebbe azzerare o gonfiare i contatori.
    match /usage/{userId} {
      allow read, write: if false;
      match /daily/{day} {
        allow read, write: if false;
      }
    }

    // 📈 Analytics: anche gli ospiti passano dall'endpoint telemetry, che valida
    // gli eventi e applica limiti. Nessuna scrittura diretta dal browser.
    // La lettura è riservata all'admin via Cloud Function (adminDashboard).
    match /analytics/{docId} {
      allow read: if false;
      allow write: if false; // Solo endpoint telemetry con validazione e limiti.
      match /sessions/{sessionId} {
        allow read: if false;
        allow write: if false; // Solo endpoint telemetry con validazione e limiti.
      }
    }

    // 🧭 Journeys: percorso per-visitatore (guest inclusi), stesso principio di /analytics.
    // Scrittura solo via backend; lettura solo admin via Cloud Function.
    match /journeys/{vid} {
      allow read: if false;
      allow write: if false; // Solo endpoint telemetry con validazione e limiti.
      match /events/{eventId} {
        allow read: if false;
        allow write: if false; // Solo endpoint telemetry con validazione e limiti.
      }
    }
  }
}
